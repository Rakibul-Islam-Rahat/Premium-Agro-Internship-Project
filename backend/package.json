{
  "name": "premium-agro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Agro secure API server (Node.js, Express and MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "seed:programme": "node scripts/seed-programme.js",
    "seed:superadmin": "node scripts/seed-superadmin.js",
    "seed:all": "npm run seed:programme && npm run seed:projects && npm run seed:superadmin",
    "seed:projects": "node scripts/seed-projects.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
