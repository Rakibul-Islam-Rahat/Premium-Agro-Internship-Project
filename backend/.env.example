# Premium Agro backend — copy this file to .env and replace placeholders locally.
# NEVER commit backend/.env or share its secrets.
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5174

# MongoDB Atlas connection. Use the database name premium_agro in the URI path.
MONGODB_URI=your_mongodb_connection_string_here

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=premium_agro_refresh
COOKIE_SECURE=false

# Authentication verification and password-reset email (Resend).
# Create a Resend API key with sending-only permissions and use a verified sender domain.
# Keep these secrets only in backend/.env; never place them in frontend env files.
RESEND_API_KEY=re_replace_with_your_resend_api_key
AUTH_EMAIL_FROM="Premium Agro <onboarding@resend.dev>"
AUTH_EMAIL_REPLY_TO=

# Keep true only for local development when email has not been configured.
# Set false after RESEND_API_KEY and AUTH_EMAIL_FROM are configured and tested.
DEVELOPMENT_LOG_AUTH_CODES=false

# Bootstrap is used only for the first SuperAdmin seed. Keep it private and remove password after seed.
BOOTSTRAP_SUPERADMIN_NAME=Premium Agro SuperAdmin
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

MAX_JSON_BODY=8mb
